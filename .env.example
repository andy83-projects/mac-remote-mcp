# mac-remote-mcp environment variables

# REQUIRED: Bearer token for API authentication
# Generate: openssl rand -hex 32
MCP_API_KEY=

# Server settings
TRANSPORT=http
PORT=3000
HOST=127.0.0.1

# TLS/HTTPS settings (optional)
# TLS_ENABLED=true
# TLS_CERT_PATH=/path/to/cert.pem
# TLS_KEY_PATH=/path/to/key.pem

# Playwright MCP proxy
PLAYWRIGHT_PORT=3001
PROXY_PORT=3002

# Bind to specific interfaces (comma-separated); default: 127.0.0.1
# HOST=127.0.0.1,10.0.0.53
